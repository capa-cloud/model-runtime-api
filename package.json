{
  "name": "model-runtime-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm scan:public",
    "dev": "pnpm --filter @model-runtime/server dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "scan:public": "node scripts/scan-public.mjs",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
